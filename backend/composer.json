{
    "name": "kaizoratech/antagloma-backend",
    "type": "project",
    "description": "Sales Order Management System Backend for Antagloma Florist",
    "keywords": [
        "laravel",
        "framework",
        "antagloma",
        "kaizora-tech"
    ],
    "license": "proprietary",
    "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "laravel/framework": "^11.0 || ^12.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10"
},
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}